# ===== Servidor =====
PORT=3000
NODE_ENV=development
TZ=America/Argentina/Buenos_Aires

# ===== Base de datos MySQL =====
# Opción A: variables sueltas (desarrollo local con MySQL Workbench)
DB_HOST=localhost
DB_PORT=3306
DB_NAME=manicuria_db
DB_USER=root
DB_PASSWORD=tu_password_de_mysql

# Opción B: una sola URL (útil para MySQL en la nube / Render).
# Si DATABASE_URL está definida, tiene prioridad sobre las variables de arriba.
# DATABASE_URL=mysql://usuario:password@host:3306/nombre_db

# true si tu proveedor de MySQL en la nube exige conexión SSL
DB_SSL=false

# true = Sequelize crea/ajusta las tablas al arrancar (sequelize.sync)
# false = usás el script sql/schema.sql que creaste en MySQL Workbench
DB_SYNC=true

# ===== Seguridad =====
# Generá uno largo y aleatorio, por ejemplo con:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=cambiame_por_un_secreto_largo_y_aleatorio
JWT_EXPIRES_IN=2h
BCRYPT_ROUNDS=10

# ===== Usuario administrador inicial =====
# Se crea automáticamente al arrancar si no existe
ADMIN_NOMBRE=Administradora
ADMIN_EMAIL=admin@manicuria.com
ADMIN_PASSWORD=Admin1234

# true = al arrancar carga servicios de ejemplo si la tabla está vacía
SEED_DEMO_DATA=true

# ===== Horario de atención (formato HH:MM) =====
HORA_APERTURA=09:00
HORA_CIERRE=20:00
