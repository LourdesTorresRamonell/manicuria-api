      "key": "baseUrl",
      "value": "http://localhost:3000/api"
    },
    {
      "key": "adminEmail",
      "value": "admin@manicuria.com"
    },
    {
      "key": "adminPassword",
      "value": "Admin1234"
    },
    {
      "key": "clienteEmail",
      "value": "clienta.postman@test.com"
    },
    {
      "key": "tokenAdmin",
      "value": ""
    },
    {
      "key": "tokenCliente",
      "value": ""
    },
    {
      "key": "servicioId",
      "value": ""
    },
    {
      "key": "turnoId",
      "value": ""
    },
    {
      "key": "usuarioId",
      "value": ""
